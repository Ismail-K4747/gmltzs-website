---
// Interactive Tanzania-centred globe (powered by cobe.js).
// Renders a list of installations admins manage from the CMS.
// Clicking a card animates the globe to that pin and shows its details.
interface Installation {
  name: string;
  region?: string;
  lat: number;
  lng: number;
  image?: string;
  deviceType?: string;
  status?: string;
  notes?: string;
}
interface Props {
  installations: Installation[];
}
const { installations } = Astro.props;
const installationsJson = JSON.stringify(installations);
---

<div class="globe-block" data-installations={installationsJson}>
  <div class="globe-block__stage">
    <canvas class="globe-block__canvas" data-globe-canvas></canvas>
    <div class="globe-block__hint">Drag the globe · click a location below</div>
  </div>

  <aside class="globe-block__panel" data-globe-panel>
    <div class="globe-block__detail" data-globe-detail aria-live="polite">
      <p class="globe-block__detail-eyebrow">Selected installation</p>
      <h3 class="globe-block__detail-name">Tap a location to learn more</h3>
      <p class="globe-block__detail-desc">Each pin marks a hospital or health centre where we have installed and commissioned solar-powered cold-chain equipment.</p>
    </div>

    <ol class="globe-block__list">
      {installations.map((i, idx) => (
        <li>
          <button type="button" class="globe-block__item" data-globe-item={idx} data-lat={i.lat} data-lng={i.lng}>
            <span class="globe-block__item-pin" aria-hidden="true">●</span>
            <span class="globe-block__item-text">
              <strong>{i.name}</strong>
              {i.region && <span>{i.region}</span>}
            </span>
          </button>
        </li>
      ))}
    </ol>
  </aside>
</div>

<script>
  // @ts-nocheck
  import createGlobe from 'cobe';

  function initGlobe(block: HTMLElement) {
    const canvas = block.querySelector<HTMLCanvasElement>('[data-globe-canvas]');
    if (!canvas) return;
    if ((canvas as any).__cobeInit) return;

    // Wait until container has real width.
    let cssWidth = canvas.offsetWidth;
    if (!cssWidth || cssWidth < 50) {
      requestAnimationFrame(() => initGlobe(block));
      return;
    }
    (canvas as any).__cobeInit = true;

    let installations: any[] = [];
    try { installations = JSON.parse(block.getAttribute('data-installations') || '[]'); } catch { installations = []; }

    // Tanzania centroid → cobe phi/theta.
    const tzLat = -6.5;
    const tzLng = 35;
    const latLngToPhiTheta = (lat: number, lng: number) => ({
      phi: (lng * Math.PI) / 180,
      theta: (lat * Math.PI) / 180,
    });

    let phi = (tzLng * Math.PI) / 180;
    let theta = (tzLat * Math.PI) / 180 * -1;
    let targetPhi = phi;
    let targetTheta = theta;
    let pointerDown = false;
    let pointerStartX = 0;
    let pointerStartPhi = 0;

    const markers = installations.map((i) => ({
      location: [i.lat, i.lng] as [number, number],
      size: 0.06,
    }));

    // Cobe v2 expects the canvas backing buffer to be pre-sized.
    // Official quickstart: <canvas width="1000" height="1000" style="width:500px;height:500px">
    const dpr = 2;
    canvas.width = cssWidth * dpr;
    canvas.height = cssWidth * dpr;
    canvas.style.height = cssWidth + 'px';

    const globe = createGlobe(canvas, {
      devicePixelRatio: dpr,
      width: cssWidth * dpr,
      height: cssWidth * dpr,
      phi,
      theta,
      dark: 1,
      diffuse: 1.2,
      mapSamples: 16000,
      mapBrightness: 6,
      baseColor: [0.3, 0.3, 0.3],
      markerColor: [0.98, 0.65, 0.12],
      glowColor: [1, 1, 1],
      markers,
      onRender: (state: any) => {
        // v2: only update animated state; do NOT touch width/height each frame.
        if (!pointerDown) {
          phi += (targetPhi - phi) * 0.08;
          theta += (targetTheta - theta) * 0.08;
        }
        state.phi = phi;
        state.theta = theta;
      },
    });

    // Fade in (cobe trick to avoid first-frame flash)
    canvas.style.opacity = '0';
    requestAnimationFrame(() => { canvas.style.transition = 'opacity .6s'; canvas.style.opacity = '1'; });

    // Resize on container changes.
    const ro = new ResizeObserver(() => {
      const w = canvas.offsetWidth;
      if (!w || w === cssWidth) return;
      cssWidth = w;
    });
    ro.observe(canvas);

    // Pointer drag
    canvas.addEventListener('pointerdown', (e) => {
      pointerDown = true;
      pointerStartX = e.clientX;
      pointerStartPhi = phi;
      canvas.setPointerCapture(e.pointerId);
      canvas.style.cursor = 'grabbing';
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!pointerDown) return;
      const dx = e.clientX - pointerStartX;
      phi = pointerStartPhi + dx / 200;
      targetPhi = phi;
    });
    const endDrag = () => { pointerDown = false; canvas.style.cursor = 'grab'; };
    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointerleave', endDrag);
    canvas.style.cursor = 'grab';

    // Wire up list buttons
    const detail = block.querySelector<HTMLElement>('[data-globe-detail]');
    const items = block.querySelectorAll<HTMLButtonElement>('[data-globe-item]');
    items.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-globe-item'));
        const i = installations[idx];
        if (!i) return;
        const { phi: tp, theta: tt } = latLngToPhiTheta(i.lat, i.lng);
        targetPhi = tp;
        targetTheta = -tt;
        items.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        if (detail) {
          const meta = [i.deviceType, i.status].filter(Boolean).join(' · ');
          detail.innerHTML = `
            ${i.image ? `<img src="${i.image}" alt="${i.name}" class="globe-block__detail-img" loading="lazy" />` : ''}
            <p class="globe-block__detail-eyebrow">${i.region || 'Tanzania'}</p>
            <h3 class="globe-block__detail-name">${i.name}</h3>
            ${meta ? `<p class="globe-block__detail-meta">${meta}</p>` : ''}
            ${i.notes ? `<p class="globe-block__detail-desc">${i.notes}</p>` : ''}
          `;
        }
      });
    });

    window.addEventListener('beforeunload', () => globe.destroy());
  }

  function initAllGlobes() {
    document.querySelectorAll<HTMLElement>('.globe-block').forEach(initGlobe);
  }

  if (document.readyState !== 'loading') initAllGlobes();
  else document.addEventListener('DOMContentLoaded', initAllGlobes);
  document.addEventListener('astro:page-load', initAllGlobes);
</script>
