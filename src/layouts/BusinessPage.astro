---
import { getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TanzaniaMap from '../components/TanzaniaMap.astro';

interface Props { slug: string; }
const { slug } = Astro.props;

const page = await getEntry('pages', slug);
if (!page) throw new Error(`Missing src/content/pages/${slug}.md`);
const d = page.data;
---
<BaseLayout
  title={d.title}
  metaDescription={d.metaDescription}
  metaKeywords={d.metaKeywords}
  canonical={d.canonical}
  ogTitle={d.ogTitle}
  ogDescription={d.ogDescription}
  bodyTheme={d.pageTheme}
>
  <SiteHeader />

    {/* ===== PAGE HERO ===== */}
    {d.pageHeroTitle && (
      <section class={`page-hero ${d.pageHeroImages?.length > 0 ? 'page-hero--slideshow' : ''}`}>
        {d.pageHeroBgClass && !(d.pageHeroImages?.length > 0) && <div class={`page-hero__bg ${d.pageHeroBgClass}`}></div>}
        {d.pageHeroImages?.length > 0 && (
          <div class="page-hero__slideshow" data-hero-slideshow>
            {d.pageHeroImages.map((src: string, i: number) => (
              <div class={`page-hero__slide ${i === 0 ? 'is-active' : ''}`} style={`background-image:url('${src}')`}></div>
            ))}
            <div class="page-hero__overlay"></div>
          </div>
        )}
        <div class="container page-hero__content">
          {d.pageHeroTag && <span class="page-hero__tag">{d.pageHeroTag}</span>}
          <h1 class="page-hero__title" set:html={d.pageHeroTitle} />
          {d.pageHeroDescription && <p class="page-hero__desc">{d.pageHeroDescription}</p>}
        </div>
      </section>
    )}

    {/* ===== ABOUT ===== */}
    {(d.pageAboutTitle || d.pageAboutParagraphs.length > 0 || d.services.length > 0) && (
      <section class="page-about section">
        <div class="container">
          {(d.pageAboutEyebrow || d.pageAboutTitle) && (
            <div class="section__header">
              {d.pageAboutEyebrow && <p class="section__eyebrow">{d.pageAboutEyebrow}</p>}
              {d.pageAboutTitle && <h2 class="section__title">{d.pageAboutTitle}</h2>}
            </div>
          )}
          {d.pageAboutParagraphs.length > 0 && (
            <div class="page-about__content">
              {d.pageAboutParagraphs.map((p) => <p>{p}</p>)}
            </div>
          )}

          {d.services.length > 0 && (
            <div class="services-grid">
              {d.services.map((s) => (
                <div class="service-card">
                  {s.iconSvg && (
                    <div class="service-card__icon">
                      <svg viewBox="0 0 24 24" set:html={s.iconSvg} />
                    </div>
                  )}
                  <h3 class="service-card__title" set:html={s.title} />
                  <p class="service-card__desc">{s.description}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    {/* ===== VIDEO TOUR (optional, reuses videoTourSlides) ===== */}
    {d.videoTourSlides.length > 0 && (
      <section class="video-tour section">
        <div class="container">
          <div class="section__header">
            <h2 class="section__title">Take a Video Tour</h2>
          </div>
          <div class="video-tour__grid">
            {d.videoTourSlides.map((v) => (
              <figure class="video-tour__item">
                <video
                  class="video-tour__video"
                  src={v.videoUrl}
                  poster={v.posterUrl}
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label={v.title ?? v.caption ?? 'Video tour clip'}
                ></video>
                {(v.title || v.caption) && (
                  <figcaption class="video-tour__caption">
                    {v.title && <strong>{v.title}</strong>}
                    {v.caption && <span>{v.caption}</span>}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ===== GALLERY (CMS-managed photos) ===== */}
    {d.galleryPhotos.length > 0 && (
      <section class="gallery section">
        <div class="container">
          {d.galleryTitle && (
            <div class="section__header">
              <h2 class="section__title">{d.galleryTitle}</h2>
            </div>
          )}
          <div class="gallery__grid">
            {d.galleryPhotos.map((p) => (
              <figure class="gallery__item">
                <img src={p.image} alt={p.alt ?? p.caption ?? ''} loading="lazy" />
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ===== CENTERS SHOWCASE (Labs / Medics) ===== */}
    {d.centers.length > 0 && (
      <section class="centers section">
        <div class="container">
          {(d.centersEyebrow || d.centersTitle || d.centersIntro) && (
            <div class="section__header">
              {d.centersEyebrow && <p class="section__eyebrow">{d.centersEyebrow}</p>}
              {d.centersTitle && <h2 class="section__title">{d.centersTitle}</h2>}
              {d.centersIntro && <p class="section__lead">{d.centersIntro}</p>}
            </div>
          )}
          <div class="centers__grid">
            {d.centers.map((c) => (
              <article class="center-card">
                {c.image && (
                  <div class="center-card__media">
                    <img src={c.image} alt={c.name} loading="lazy" />
                  </div>
                )}
                <div class="center-card__body">
                  <h3 class="center-card__name">{c.name}</h3>
                  {c.tagline && <p class="center-card__tagline">{c.tagline}</p>}
                  <ul class="center-card__meta">
                    {c.address && <li><strong>Where:</strong> {c.address}</li>}
                    {c.phone && <li><strong>Call:</strong> <a href={`tel:${c.phone.replace(/\s+/g, '')}`}>{c.phone}</a></li>}
                    {c.hours && <li><strong>Hours:</strong> {c.hours}</li>}
                  </ul>
                  {c.highlights.length > 0 && (
                    <ul class="center-card__highlights">
                      {c.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  )}
                  {c.mapUrl && <a href={c.mapUrl} class="btn btn--outline btn--sm" target="_blank" rel="noopener">Open in Maps</a>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ===== GOVERNMENT PROJECTS (Devices) ===== */}
    {d.govProjects.length > 0 && (
      <section class="gov-projects section">
        <div class="container">
          {(d.govProjectsEyebrow || d.govProjectsTitle || d.govProjectsIntro) && (
            <div class="section__header">
              {d.govProjectsEyebrow && <p class="section__eyebrow">{d.govProjectsEyebrow}</p>}
              {d.govProjectsTitle && <h2 class="section__title">{d.govProjectsTitle}</h2>}
              {d.govProjectsIntro && <p class="section__lead">{d.govProjectsIntro}</p>}
              <div class="bmed-projects__partner" aria-label="In partnership with the Government of the United Republic of Tanzania">
                <span class="bmed-projects__partner-label">In partnership with</span>
                <img class="bmed-projects__partner-logo" src="/images/trusted/gvtz.svg" alt="Government of the United Republic of Tanzania" loading="lazy" />
              </div>
            </div>
          )}
          <div class="gov-projects__grid">
            {d.govProjects.map((p) => (
              <article class="gov-card">
                {p.image && (
                  <div class="gov-card__media">
                    <img src={p.image} alt={p.title} loading="lazy" />
                    {p.year && <span class="gov-card__year">{p.year}</span>}
                  </div>
                )}
                <div class="gov-card__body">
                  <h3 class="gov-card__title">{p.title}</h3>
                  {p.location && <p class="gov-card__location">📍 {p.location}</p>}
                  <p class="gov-card__desc">{p.description}</p>
                  {p.results.length > 0 && (
                    <ul class="gov-card__results">
                      {p.results.map((r) => <li>{r}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ===== PARTNER SPOTLIGHT ===== */}
    {d.partner && (
      <section class="partner-spotlight section">
        <div class="container">
          <div class="partner-spotlight__inner">
            {d.partner.logo && (
              <div class="partner-spotlight__logo">
                <img src={d.partner.logo} alt={d.partner.name} loading="lazy" />
              </div>
            )}
            <div class="partner-spotlight__copy">
              <p class="partner-spotlight__eyebrow">In Partnership With</p>
              <h2 class="partner-spotlight__name">{d.partner.name}</h2>
              {d.partner.tagline && <p class="partner-spotlight__tagline">{d.partner.tagline}</p>}
              {d.partner.description && <p class="partner-spotlight__desc">{d.partner.description}</p>}
              {d.partner.websiteUrl && <a href={d.partner.websiteUrl} class="btn btn--outline" target="_blank" rel="noopener">Visit {d.partner.name} →</a>}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* ===== INTERACTIVE GLOBE — INSTALLATIONS ===== */}
    {d.installations.length > 0 && (
      <section class="installations section">
        <div class="container">
          {(d.installationsEyebrow || d.installationsTitle || d.installationsIntro) && (
            <div class="section__header">
              {d.installationsEyebrow && <p class="section__eyebrow">{d.installationsEyebrow}</p>}
              {d.installationsTitle && <h2 class="section__title">{d.installationsTitle}</h2>}
              {d.installationsIntro && <p class="section__lead">{d.installationsIntro}</p>}
            </div>
          )}
          <TanzaniaMap installations={d.installations} coveredRegions={d.sddCoveredRegions ?? []} />
        </div>
      </section>
    )}

    {/* ===== B MEDICAL SYSTEMS PROJECTS ===== */}
    {(d.bMedicalProjects?.length ?? 0) > 0 && (
      <section class="bmed-projects section">
        <div class="container">
          {(d.bMedicalProjectsEyebrow || d.bMedicalProjectsTitle || d.bMedicalProjectsIntro) && (
            <div class="section__header">
              {d.bMedicalProjectsEyebrow && <p class="section__eyebrow">{d.bMedicalProjectsEyebrow}</p>}
              {d.bMedicalProjectsTitle && <h2 class="section__title">{d.bMedicalProjectsTitle}</h2>}
              {d.bMedicalProjectsIntro && <p class="section__lead">{d.bMedicalProjectsIntro}</p>}
              <div class="bmed-projects__partner">
                <span class="bmed-projects__partner-label">In partnership with</span>
                <img src="/images/trusted/b-medical-systems.svg" alt="B Medical Systems" class="bmed-projects__partner-logo" loading="lazy" />
              </div>
            </div>
          )}
          <div class="bmed-projects__grid">
            {d.bMedicalProjects.map((p: any) => (
              <article class="bmed-project">
                <header class="bmed-project__header">
                  <span class="bmed-project__code">{p.code}</span>
                  {p.year && <span class="bmed-project__year">{p.year}</span>}
                </header>
                <h3 class="bmed-project__name">{p.name}</h3>
                {p.description && <p class="bmed-project__desc">{p.description}</p>}
                {p.regions?.length > 0 && (
                  <ul class="bmed-project__regions">
                    {p.regions.map((r: string) => (<li>{r}</li>))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* ===== HORIZONTAL TESTIMONIAL PANEL ===== */}
    {d.panelTestimonials.length > 0 && (
      <section class="testimonial-panel section">
        <div class="container">
          {(d.panelTestimonialsEyebrow || d.panelTestimonialsTitle) && (
            <div class="section__header">
              {d.panelTestimonialsEyebrow && <p class="section__eyebrow">{d.panelTestimonialsEyebrow}</p>}
              {d.panelTestimonialsTitle && <h2 class="section__title">{d.panelTestimonialsTitle}</h2>}
            </div>
          )}
          <div class="testimonial-panel__strip" role="list">
            {d.panelTestimonials.map((t) => (
              <article class="testimonial-card" role="listitem">
                <svg class="testimonial-card__quote" viewBox="0 0 24 24" fill="currentColor" width="28" height="28"><path d="M9.17 6A5.17 5.17 0 004 11.17v6.66h6.67V11.17H6.83A2.34 2.34 0 019.17 8.83V6zm10 0a5.17 5.17 0 00-5.17 5.17v6.66h6.67V11.17h-3.84A2.34 2.34 0 0119.17 8.83V6z"/></svg>
                <p class="testimonial-card__quote-text">{t.quote}</p>
                <div class="testimonial-card__author">
                  {t.avatar && <img src={t.avatar} alt={t.name} class="testimonial-card__avatar" loading="lazy" />}
                  <div>
                    <strong>{t.name}</strong>
                    {(t.role || t.organization) && (
                      <span>{[t.role, t.organization].filter(Boolean).join(' · ')}</span>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <slot />

    {/* ===== CTA ===== */}
    {d.ctaBanner && (
      <section class="cta-banner">
        <div class="container">
          <h2 class="cta-banner__title">{d.ctaBanner.title}</h2>
          <p class="cta-banner__desc">{d.ctaBanner.description}</p>
          <a href={d.ctaBanner.buttonHref} class="btn btn--primary btn--lg">{d.ctaBanner.buttonLabel}</a>
        </div>
      </section>
    )}

    <SiteFooter />

    <script is:inline>
      (function () {
        const root = document.querySelector('[data-hero-slideshow]');
        if (!root) return;
        const slides = root.querySelectorAll('.page-hero__slide');
        if (slides.length < 2) return;
        let i = 0;
        setInterval(function () {
          slides[i].classList.remove('is-active');
          i = (i + 1) % slides.length;
          slides[i].classList.add('is-active');
        }, 5000);
      })();
    </script>

    {d.whatsappMessage && (
      <a href={`https://wa.me/255713879876?text=${encodeURIComponent(d.whatsappMessage)}`} class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">
        <svg viewBox="0 0 32 32" width="32" height="32" fill="#fff"><path d="M16.004 0h-.008C7.174 0 0 7.176 0 16.004c0 3.5 1.128 6.744 3.046 9.378L1.054 31.2l6.044-1.94a15.9 15.9 0 008.906 2.704C24.826 31.964 32 24.788 32 16.004 32 7.176 24.826 0 16.004 0zm9.318 22.614c-.39 1.1-2.274 2.038-3.146 2.134-.872.098-1.672.392-5.632-1.174-4.768-1.886-7.794-6.768-8.03-7.084-.234-.316-1.916-2.548-1.916-4.862 0-2.312 1.212-3.452 1.642-3.924.43-.47.938-.588 1.252-.588.312 0 .626.002.898.016.288.014.676-.11 1.058.808.39.938 1.33 3.25 1.448 3.484.116.234.194.508.038.822-.156.314-.234.51-.468.784-.234.274-.492.612-.702.822-.234.234-.478.488-.206.958.274.47 1.214 2.002 2.606 3.244 1.788 1.594 3.296 2.088 3.766 2.322.47.234.744.196 1.018-.118.274-.314 1.174-1.37 1.488-1.84.312-.47.626-.39 1.056-.234.43.156 2.742 1.292 3.212 1.526.47.234.784.352.898.548.118.196.118 1.13-.274 2.228z"/></svg>
      </a>
    )}
</BaseLayout>
